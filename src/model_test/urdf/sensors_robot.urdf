<?xml version="1.0"?>
<robot name="sensors_robot">

  <!-- Dummy Root Link (Fixes KDL Inertia Warning) -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 车体 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://model_test/meshes/visual/80.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://model_test/meshes/collision/80.stl" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Gazebo Planar Move Plugin -->
  <gazebo>
    <plugin name="object_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>50.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <cmdTimeout>-1.0</cmdTimeout>
    </plugin>
  </gazebo>

  <!-- ================= SENSORS (GPU) ================= -->

  <!-- 1. LiDAR (128-line GPU) -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <!-- Support Stand -->
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.01" length="0.2"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar_controller" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 2. Kinect Cameras (Front & Rear) -->
  <!-- Front Kinect -->
  <link name="kinect_front_link">
    <visual><geometry><box size="0.01 0.03 0.01"/></geometry></visual>
    <collision><geometry><box size="0.01 0.03 0.01"/></geometry></collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  
  <joint name="kinect_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kinect_front_link"/>
    <origin xyz="0.35 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- Optical Frame for Plugin -->
  <link name="kinect_front_optical_link"/>
  <joint name="kinect_front_optical_joint" type="fixed">
    <parent link="kinect_front_link"/>
    <child link="kinect_front_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="kinect_front_link">
    <sensor type="depth" name="kinect_front_sensor">
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <plugin name="kinect_front_controller" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>kinect_front</cameraName>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>kinect_front_optical_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Rear Kinect -->
  <link name="kinect_rear_link">
    <visual><geometry><box size="0.01 0.03 0.01"/></geometry></visual>
    <collision><geometry><box size="0.01 0.03 0.01"/></geometry></collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  
  <joint name="kinect_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kinect_rear_link"/>
    <origin xyz="-0.4 0 0.2" rpy="0 0 3.14159"/>
  </joint>

  <!-- Optical Frame for Plugin -->
  <link name="kinect_rear_optical_link"/>
  <joint name="kinect_rear_optical_joint" type="fixed">
    <parent link="kinect_rear_link"/>
    <child link="kinect_rear_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="kinect_rear_link">
    <sensor type="depth" name="kinect_rear_sensor">
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <plugin name="kinect_rear_controller" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>kinect_rear</cameraName>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>kinect_rear_optical_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 3. Cameras (6 Surround) -->
  <!-- Cam 1: Front -->
  <link name="camera_front_link"><visual><geometry><box size="0.03 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_front_joint" type="fixed"><parent link="base_link"/><child link="camera_front_link"/><origin xyz="0.34 0 0.16" rpy="0 0 0"/></joint>
  <gazebo reference="camera_front_link">
    <sensor type="camera" name="camera_front">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_front</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_front_link</frameName></plugin>
    </sensor>
  </gazebo>

  <!-- Cam 2: Front Left (60 deg) -->
  <link name="camera_fl_link"><visual><geometry><box size="0.06 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_fl_joint" type="fixed"><parent link="base_link"/><child link="camera_fl_link"/><origin xyz="0.15 0.14 0.16" rpy="0 0 1.047"/></joint>
  <gazebo reference="camera_fl_link">
    <sensor type="camera" name="camera_fl">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_fl</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_fl_link</frameName></plugin>
    </sensor>
  </gazebo>

  <!-- Cam 3: Front Right (-60 deg) -->
  <link name="camera_fr_link"><visual><geometry><box size="0.06 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_fr_joint" type="fixed"><parent link="base_link"/><child link="camera_fr_link"/><origin xyz="0.15 -0.14 0.16" rpy="0 0 -1.047"/></joint>
  <gazebo reference="camera_fr_link">
    <sensor type="camera" name="camera_fr">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_fr</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_fr_link</frameName></plugin>
    </sensor>
  </gazebo>

  <!-- Cam 4: Back -->
  <link name="camera_back_link"><visual><geometry><box size="0.05 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_back_joint" type="fixed"><parent link="base_link"/><child link="camera_back_link"/><origin xyz="-0.41 0 0.16" rpy="0 0 3.14159"/></joint>
  <gazebo reference="camera_back_link">
    <sensor type="camera" name="camera_back">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_back</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_back_link</frameName></plugin>
    </sensor>
  </gazebo>

  <!-- Cam 5: Back Left (120 deg) -->
  <link name="camera_bl_link"><visual><geometry><box size="0.06 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_bl_joint" type="fixed"><parent link="base_link"/><child link="camera_bl_link"/><origin xyz="-0.2 0.14 0.16" rpy="0 0 2.094"/></joint>
  <gazebo reference="camera_bl_link">
    <sensor type="camera" name="camera_bl">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_bl</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_bl_link</frameName></plugin>
    </sensor>
  </gazebo>

  <!-- Cam 6: Back Right (-120 deg) -->
  <link name="camera_br_link"><visual><geometry><box size="0.06 0.01 0.01"/></geometry></visual></link>
  <joint name="camera_br_joint" type="fixed"><parent link="base_link"/><child link="camera_br_link"/><origin xyz="-0.2 -0.14 0.16" rpy="0 0 -2.094"/></joint>
  <gazebo reference="camera_br_link">
    <sensor type="camera" name="camera_br">
      <update_rate>10.0</update_rate>
      <camera><horizontal_fov>1.396</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.02</near><far>300</far></clip></camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so"><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate><cameraName>camera_br</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>camera_br_link</frameName></plugin>
    </sensor>
  </gazebo>
  
</robot>
