<sdf version='1.6'>
  <world name='default'>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 -6 8 0 0.8 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane (10x10) -->
    <model name='custom_ground'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file:///home/xlf/test_ws/src/model_test/media/materials/scripts/custom_course.material</uri>
              <name>Custom/SandRocks</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- OUTER WALLS (5x5m Box) -->
    <model name='wall_1'>
      <pose>0 2.5 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry> <box> <size>5.2 0.2 1</size> </box> </geometry>
        </collision>
        <visual name='visual'>
          <geometry> <box> <size>5.2 0.2 1</size> </box> </geometry>
          <material>
            <script> <uri>file://media/materials/scripts/gazebo.material</uri> <name>Gazebo/White</name> </script>
          </material>
        </visual>
      </link>
    </model>

    <model name='wall_2'>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry> <box> <size>5.2 0.2 1</size> </box> </geometry>
        </collision>
        <visual name='visual'>
          <geometry> <box> <size>5.2 0.2 1</size> </box> </geometry>
          <material>
            <script> <uri>file://media/materials/scripts/gazebo.material</uri> <name>Gazebo/White</name> </script>
          </material>
        </visual>
      </link>
    </model>

    <model name='wall_3'>
      <pose>2.5 0 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
