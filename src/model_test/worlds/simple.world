    <!-- OBSTACLES (In the corridor) -->
    <model name='cylinder_1'>
      <pose>1.75 0 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry> <cylinder> <radius>0.1</radius> <length>1</length> </cylinder> </geometry>
        </collision>
        <visual name='visual'>
          <geometry> <cylinder> <radius>0.1</radius> <length>1</length> </cylinder> </geometry>
          <material>
            <script> <uri>file://media/materials/scripts/gazebo.material</uri> <name>Gazebo/Black</name> </script>
